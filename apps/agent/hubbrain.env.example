# HubBrain V5 environment configuration
# Copy to /etc/ztd/hubbrain.env and set permissions: chmod 600 /etc/ztd/hubbrain.env
# Values must be provisioned manually by a Monitoring VPS admin.

# Hub identity — issued by Monitoring VPS admin panel
HUB_ID=hub-raspi-REPLACE_ME
HUB_KEY=REPLACE_ME_WITH_SECRET_HUB_KEY

# Monitoring VPS base URL
SERVER_URL=https://monitoring.example.com

# MQTT broker connection (HubBrain reads from env at startup)
MQTT_HOST=mqtt.example.com
MQTT_PORT=8883
MQTT_USER=hub-raspi-REPLACE_ME
MQTT_PASS=REPLACE_ME_WITH_MQTT_PASSWORD
